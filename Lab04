-- task 4.1
SELECT name FROM production.product WHERE listprice > 50
UNION
SELECT name FROM production.product WHERE color IS NULL;

-- task 4.2
SELECT color FROM production.product WHERE listprice > 1000
INTERSECT
SELECT p.color 
FROM production.product p
JOIN production.productcategory pc ON p.productcategoryid = pc.productcategoryid
WHERE pc.name = 'Components';

