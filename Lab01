UPDATE SalesLT.SalesOrderHeader
SET ShipDate = NULL
WHERE SalesOrderID > 71899;

select SalesOrderID,
case 
when ShipDate is not null then 'Shipped'
else 'Awaiting Shipment'
end as ShippingStatus
from SalesLT.SalesOrderHeader;
